# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows Command Prompt)
# ".env" is listed in .gitignore, so it will NOT be committed.
# ".env.example" has fake placeholder values and IS committed.

# ---------- Database (PostgreSQL) ----------
DATABASE_NAME=transithub
DATABASE_USERNAME=transithub_user
DATABASE_PASSWORD=change_me_to_a_strong_password
# Spring Boot reads this one (used in Phase 3). Must match the values above.
DATABASE_URL=jdbc:postgresql://localhost:5432/transithub

# ---------- Security ----------
# Secret used to sign login tokens (JWT). Use a long random string (32+ characters).
# Example of generating one:  openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
# How long a login token stays valid, in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ---------- Web ----------
# The address of the React app, so the backend allows its requests (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173
